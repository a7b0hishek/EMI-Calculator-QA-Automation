# Express server port
PORT=3000

# Base address used by browser automation and local app links.
# Keep this in environment configuration rather than test source files.
APP_BASE_URL=http://127.0.0.1:3000

# Browser automation runs headless unless explicitly disabled.
BROWSER_HEADLESS=true

# External API base URL, kept separate from the local application URL.
JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com

# Optional fallback to a locally installed Chrome/Chromium executable.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chrome-or-chromium
