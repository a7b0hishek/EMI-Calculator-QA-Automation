{
  "name": "streamhub-loan-emi-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Loan EMI dashboard and Cucumber/Playwright automation assessment",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app/server.js",
    "start:dev": "node --watch app/server.js",
    "test": "npm run test:cucumber",
    "test:cucumber": "cucumber-js --config cucumber.js --tags \"not @broken-locator\" --format json:reports/cucumber-report.json",
    "test:ui": "cucumber-js --config cucumber.js --tags @ui --format json:reports/cucumber-ui-report.json",
    "test:api": "cucumber-js --config cucumber.js --tags @api --format json:reports/cucumber-api-report.json",
    "test:api:local": "cucumber-js --config cucumber.js --tags @api-local --format json:reports/cucumber-api-local-report.json",
    "test:broken-locators": "cucumber-js --config cucumber.js --tags @broken-locator --format json:reports/cucumber-broken-locators-report.json"
  },
  "dependencies": {
    "chart.js": "4.6.1",
    "dotenv": "18.0.8",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "playwright": "1.64.1"
  }
}
